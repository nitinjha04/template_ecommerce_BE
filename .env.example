NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/casaq_ecommerce

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Seed scripts — override v2 image base (default: https://uat.tangerineluxury.com)
# SEED_MEDIA_BASE_URL=https://uat.tangerineluxury.com

# Seed admin (optional overrides)
SEED_ADMIN_EMAIL=casaqte@gmail.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Casaq Admin

# Transactional email (disabled by default)
EMAIL_ENABLED=false
# Brevo / Sendinblue
SENDINBLUE_API_KEY=your_sendinblue_api_key
# (alias supported)
# BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=Casaq <casaqte@gmail.com>
# Optional per-site FROM overrides (picked by store domain)
SMTP_FROM_CASAQ=Casaq Technology Private Limited <robovolt0909@gmail.com>
SMTP_FROM_ARGEN=Argen Technology Private Limited <robovolt0909@gmail.com>
ADMIN_EMAIL=casaqte@gmail.com
# Per-store "new order" emails (in addition to ADMIN_EMAIL)
# Format: domain=email1,email2;domain2=email3  (use quotes — ; may look "commented" in the editor)
# DSA Gateway (PayPro) — optional
# MERCHANT_ID=
# PRIVATE_KEY=
# PUBLIC_KEY=
# PAYMENT_BASE_URL=
# Fallback gateway when domain is unknown / not listed below
# GATEWAY_ID=489819
#
# Per-store gateway IDs (REQUIRED for multi-store on one API):
# Format: domain=gatewayId;domain2=gatewayId2
# Example:
# STORE_DSA_GATEWAY_IDS="casaq.in=489819;protico.in=490009"
# STORE_DSA_GATEWAY_IDS=

# Per-store frontend origins for PayPro return URLs (optional).
# If unset, BE uses https://{store-domain} (e.g. https://protico.in/payment-return?...).
# Format: domain=https://origin;domain2=https://origin2
# STORE_FRONTEND_URLS="casaq.in=https://casaq.in;protico.in=https://protico.in"
# Global fallback when domain unknown:
# PAYMENT_RETURN_URL=https://your-default-storefront.example
# FRONTEND_URL=https://your-default-storefront.example

# Razorpay — set KEY_ID + KEY_SECRET to enable; webhook secret optional but recommended
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From Razorpay Dashboard → Settings → Webhooks (events: payment.captured)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Webhook URL: https://<your-api-host>/api/v1/payments/razorpay/webhook

# Direct UPI (optional)
# DIRECT_UPI_VPA=merchant@upi

