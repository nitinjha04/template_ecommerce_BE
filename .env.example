NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lucidus_ecommerce

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Seed scripts — override v2 image base (default: https://uat.tangerineluxury.com)
# SEED_MEDIA_BASE_URL=https://uat.tangerineluxury.com

# Seed admin (optional overrides)
SEED_ADMIN_EMAIL=admin@lucidus.in
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Admin User

# SMTP email (disabled by default — uncomment email calls in order.service.ts to use)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Lucidus <noreply@lucidus.in>
ADMIN_EMAIL=admin@lucidus.in
